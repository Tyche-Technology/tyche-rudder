DATABASE_URL=postgres://rudder:rudder@localhost:5432/rudder

# Generate your own — never commit a real one, and never ship a shared value.
# Anyone who knows the secret can forge a session cookie for any user id.
# The placeholder below is deliberately rejected at boot (see
# src/lib/auth-secret.ts) — replace it before running anything for real.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=change-me-32-chars-minimum-secret!!
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth (optional in dev — login page's Google button errors politely without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack notifications (optional — unset SLACK_BOT_TOKEN disables them entirely)
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=C0123456789
# APP_BASE_URL=

# Attachment object store — "fs" works without a cloud provider and stores
# files under .rudder-objects/. Use "gcs" with a bucket name and ADC credentials.
OBJECT_STORE_BACKEND=fs
GCS_BUCKET=
