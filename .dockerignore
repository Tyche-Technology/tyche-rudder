# root-level test-harness config, not runtime code. tsconfig's `**/*.ts`
# include means `next build`'s type check picks this up even though nothing
# at runtime imports it — and it imports from ./tests/e2e/helpers, which
# doesn't exist once `tests` above is excluded. Keep it out of the image the
# same way `tests` itself is; don't drop it while "cleaning up" this list.
playwright.config.ts
